# ─────────────────────────────────────────────
# Visitor Counter — GitHub Gist (Self-Owned)
# ─────────────────────────────────────────────
# 1. Create a secret Gist at https://gist.github.com
#    Filename: visitor-count.json
#    Content:  {"count": 0}
#
# 2. Generate a GitHub PAT at:
#    https://github.com/settings/tokens
#    Required scope: gist
#
# 3. Copy the Gist ID from the URL:
#    https://gist.github.com/YOUR_USERNAME/<GIST_ID>
#
# For local dev: copy this file to .env.local and fill in values
# For production: add these to Vercel → Settings → Environment Variables

GITHUB_GIST_TOKEN=your_github_personal_access_token_here
GITHUB_GIST_ID=your_gist_id_here

# ─────────────────────────────────────────────
# GitHub API (used for other portfolio features)
# ─────────────────────────────────────────────
VITE_GITHUB_TOKEN=your_github_personal_access_token_here
VITE_GITHUB_PAT=your_github_personal_access_token_here
